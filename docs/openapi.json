  "components": {
    "schemas": {
      "Body_upload_document_api_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "document_type": {
            "type": "string",
            "title": "Document Type",
            "default": "knowledge"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_upload_post"
      },
      "ClearSessionRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "ClearSessionRequest"
      },
      "ComplianceReviewRequest": {
        "properties": {
          "design": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Design"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "design"
        ],
        "title": "ComplianceReviewRequest"
      },
      "ComplianceReviewResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPLIANT",
              "PARTIAL",
              "NON_COMPLIANT",
              "NOT_REVIEWED",
              "REVIEW_BLOCKED"
            ],
            "title": "Status"
          },
          "review": {
            "type": "string",
            "title": "Review"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceDocument"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "status",
          "review"
        ],
        "title": "ComplianceReviewResponse"
      },
      "FeedbackAcknowledgement": {
        "properties": {
          "status": {
            "type": "string",
            "const": "recorded",
            "title": "Status"
          },
          "interaction_id": {
            "type": "string",
            "title": "Interaction Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "interaction_id"
        ],
        "title": "FeedbackAcknowledgement"
      },
      "FeedbackReport": {
        "properties": {
          "total_feedback": {
            "type": "integer",
            "title": "Total Feedback"
          },
          "average_rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Rating"
          },
          "ratings": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Ratings"
          }
        },
        "type": "object",
        "required": [
          "total_feedback"
        ],
        "title": "FeedbackReport"
      },
      "FeedbackSubmission": {
        "properties": {
          "interaction_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Interaction Id"
          },
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "interaction_id",
          "rating"
        ],
        "title": "FeedbackSubmission"
      },
      "GitHubIndexAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "GitHubIndexAccepted"
      },
      "GitHubIndexRequest": {
        "properties": {
          "owner": {
            "type": "string",
            "maxLength": 39,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$",
            "title": "Owner"
          },
          "repository": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Repository"
          }
        },
        "type": "object",
        "required": [
          "owner",
          "repository"
        ],
        "title": "GitHubIndexRequest"
      },
      "GitHubIndexStatus": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "GitHubIndexStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "document_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Name"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceDocument"
            },
            "type": "array",
            "title": "Sources",
            "default": []
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interaction Id"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "QueryResponse"
      },
      "SourceDocument": {
        "properties": {
          "document_name": {
            "type": "string",
            "title": "Document Name"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "similarity_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Similarity Score"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "source_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Type"
          },
          "page_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Number"
          },
          "image_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Index"
          },
          "source_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Path"
          },
          "line_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line Start"
          },
          "line_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line End"
          },
          "repository": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repository"
          },
          "branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Branch"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "document_name",
          "chunk_id",
          "score",
          "snippet"
        ],
        "title": "SourceDocument"
      },
      "UploadResponse": {
        "properties": {
          "document_name": {
            "type": "string",
            "title": "Document Name"
          },
          "chunks_created": {
            "type": "integer",
            "title": "Chunks Created"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "document_name",
          "chunks_created",
          "message"
        ],
        "title": "UploadResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}